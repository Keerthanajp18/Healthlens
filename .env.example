# HealthLens Person 2 - Environment Variables Configuration

# Optional: Google Gemini API Key for dynamic LLM generation and embeddings
# If left empty, HealthLens runs in local grounded clinical retrieval mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Configuration: "sentence-transformers" (default, runs locally), "gemini", or "fallback"
EMBEDDING_BACKEND=sentence-transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Generation Model Configuration
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Chunking & Retrieval Parameters
CHUNK_SIZE=450
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.20
